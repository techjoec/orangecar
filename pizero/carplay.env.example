# /etc/rascar/carplay.env — read by rascar-carplay.service.
# Every variable is optional; see README.md for the full list.

# What to show on the car screen:
#   test                 moving test card (default)
#   color:1d1d1f         solid colour (cheapest)
#   image:/etc/rascar/screen.png
#   fb  or  fb:/dev/fb0  the Pi's framebuffer (draw anything there)
#   ffmpeg:<args>        raw ffmpeg input arguments
#RASCAR_VIDEO_SOURCE=test

# static (default for test/color/image): encode a 1 s clip ONCE, cache it in
# /var/lib/rascar/video-cache and replay it — no encoder runs during a session.
# live: run ffmpeg for the whole session (always the case for fb / ffmpeg:).
# none: no video at all — the car keeps its own UI on screen (lightest; untested in a car).
#RASCAR_VIDEO_MODE=static

#RASCAR_VIDEO_FPS=15
#RASCAR_VIDEO_BITRATE_KBPS=2000
#RASCAR_VIDEO_KEYINT=15
# v4l2m2m (Pi hardware, default when present) | x264 | openh264
#RASCAR_VIDEO_ENCODER=v4l2m2m

# Car touches and steering-wheel keys arrive as text lines on this UDP address
# ("touch down 412 233", "key play-pause"). "off" disables.
#RASCAR_EVENTS_ADDR=127.0.0.1:7705

# Only if `ls /sys/class/usb_role` is empty (kernel without USB role switch):
#RASCAR_ROLE_SWITCH_CMD=/usr/local/sbin/rascar-role-switch-rebind

# 1 = debug logging; RASCAR_WIRE_TRACE=1 adds hex dumps of USB/iAP2/RTSP.
#RASCAR_DEBUG=0
#RASCAR_WIRE_TRACE=0
