[Unit]
Description=OrangeCar minimal CarPlay iPhone (iPhone side only, e.g. Pi Zero W)
After=avahi-daemon.service
Wants=avahi-daemon.service
# Same USB port as the full build: never run both.
Conflicts=rascar-carplay.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/rascar/carplay.env
ExecStart=/usr/local/sbin/rascar-carplay-minimal-run
Restart=always
# A few seconds between attempts: re-presenting the iPhone too quickly makes
# some head units stop offering CarPlay for a while.
RestartSec=10
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
