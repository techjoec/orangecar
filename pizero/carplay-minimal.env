# /etc/rascar/carplay.env — the minimal "iPhone side only" profile (Pi Zero W).
#
# Read by rascar-carplay-minimal.service. Edit, then:
#   sudo systemctl restart rascar-carplay-minimal
# Everything not set here keeps the OrangeCar default (carplay/README.md).

# --- What the profile turns off ----------------------------------------------
# No rascar-app on this board: no dashboard, no audio, no Now Playing.
RASCAR_CARPLAY_AUDIO=off
RASCAR_NOWPLAYING=off

# --- Hardware -----------------------------------------------------------------
# The Pi Zero's dwc2 OTG controller (Pi 4: fe980000.usb).
RASCAR_UDC=20980000.usb
# Only if `ls /sys/class/usb_role` is empty (kernel without USB role switch):
#RASCAR_ROLE_SWITCH_CMD=/usr/local/sbin/rascar-role-switch-rebind

# --- Video --------------------------------------------------------------------
# none                 no video at all: the car keeps its own UI (lightest;
#                      unverified in a car — if the session drops ~7-8 s in,
#                      use static instead)
# static (default)     encode a 1 s clip of the picture ONCE, cache it in
#                      /var/lib/rascar/video-cache, replay it — no encoder runs
#                      during a session
# live                 run ffmpeg for the whole session (always for fb / ffmpeg:)
RASCAR_VIDEO_MODE=static

# The picture (ignored with RASCAR_VIDEO_MODE=none):
#   test                 moving test card
#   color:1d1d1f         solid colour
#   image:/etc/rascar/screen.png
#   fb  or  fb:/dev/fb0  the Pi's framebuffer (live)
#   ffmpeg:<args>        raw ffmpeg input arguments (live)
RASCAR_VIDEO_SOURCE=color:1d1d1f

# The Pi's VideoCore hardware H.264 encoder.
RASCAR_VIDEO_ENCODER=v4l2m2m
RASCAR_VIDEO_FPS=15
RASCAR_VIDEO_BITRATE_KBPS=2000
RASCAR_VIDEO_KEYINT=15

# Car touches and steering-wheel keys as UDP text lines
# ("touch down 412 233", "key next"); try `nc -ulk 7705`.
RASCAR_EVENTS_ADDR=127.0.0.1:7705

# --- Identity / logging ---------------------------------------------------------
# Host label in the _carplay-ctrl mDNS record: use the Pi's hostname.
RASCAR_CTRL_HOSTLABEL=raspberrypi
# 1 = debug logging; RASCAR_WIRE_TRACE=1 adds hex dumps of USB/iAP2/RTSP.
#RASCAR_DEBUG=0
#RASCAR_WIRE_TRACE=0
